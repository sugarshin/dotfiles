{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "terminal": {
    "copyOnSelect": false
  },
  "shortcuts": {
    "bindings": {
      "focusLeft": "opt+cmd+h",
      "focusDown": "opt+cmd+j",
      "focusUp": "opt+cmd+k",
      "focusRight": "opt+cmd+l",
      "toggleSidebar": "cmd+ctrl+e",
      "toggleSplitZoom": "cmd+shift+z",
      // Free ctrl+shift+j/k for Claude Code scrolling (claude/keybindings.json)
      "resize-pane-up": null,
      "resize-pane-down": null
    }
  }
}
